{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "JwtSettings": {
    "SecretKey": "",
    "RequireHttpsMetadata": true
  },
  "SecuritySettings": {
    "EnableRateLimiting": true,
    "MaxRequestsPerMinute": 60,
    "EnableIPWhitelist": true,
    "RequireApiKey": true
  },
  "StorageSettings": {
    "Provider": "Azure",
    "Azure": {
      "ConnectionString": "",
      "EnableCDN": true
    }
  },
  "CacheSettings": {
    "EnableDistributedCache": true
  },
  "HealthChecks": {
    "EnableDetailedErrors": false
  }
}
