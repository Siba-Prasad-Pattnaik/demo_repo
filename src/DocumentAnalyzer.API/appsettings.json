{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=DocumentAnalyzerDb;Trusted_Connection=true;MultipleActiveResultSets=true;TrustServerCertificate=true",
    "Redis": "localhost:6379",
    "RedisConnection": "localhost:6379"
  },
  "Jwt": {
    "Key": "YourSuperSecretKeyThatIsAtLeast256BitsLongForProduction!",
    "Issuer": "DocumentAnalyzer.API",
    "Audience": "DocumentAnalyzer.Client",
    "ExpireMinutes": 60,
    "RefreshExpireDays": 7
  },
  "JwtSettings": {
    "SecretKey": "DocumentAnalyzer-SuperSecretKey-ChangeInProduction-32CharactersMinimum!",
    "Issuer": "DocumentAnalyzer.API",
    "Audience": "DocumentAnalyzer.Client",
    "TokenLifetimeMinutes": 60,
    "ExpiryInMinutes": 60,
    "RefreshTokenLifetimeDays": 7,
    "RefreshTokenExpiryInDays": 7,
    "RequireHttpsMetadata": true,
    "SaveToken": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "https://localhost:3000",
      "https://localhost:3001",
      "https://localhost:5173",
      "https://documentanalyzer.com"
    ],
    "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "AllowedHeaders": ["Content-Type", "Authorization", "X-Requested-With", "X-API-Key", "X-Version"],
    "AllowCredentials": true,
    "PreflightMaxAgeMinutes": 10
  },
  "RateLimit": {
    "PermitLimit": 100,
    "WindowMinutes": 1,
    "WindowInMinutes": 1,
    "QueueLimit": 10
  },
  "Storage": {
    "Provider": "LocalFile",
    "LocalPath": "./uploads",
    "MaxFileSizeBytes": 104857600,
    "AllowedExtensions": [".pdf", ".docx", ".txt", ".jpg", ".png"],
    "AzureBlobConnection": "",
    "AzureBlobContainer": "documents"
  },
  "StorageSettings": {
    "Provider": "Local",
    "FileSystemPath": "./uploads",
    "LocalPath": "./uploads",
    "MaxFileSizeMB": 50,
    "MaxFileSizeBytes": 104857600,
    "AllowedExtensions": [".pdf", ".doc", ".docx", ".txt", ".rtf", ".jpg", ".png"],
    "Azure": {
      "ConnectionString": "",
      "ContainerName": "documents",
      "EnableCDN": false
    },
    "AzureStorage": {
      "ConnectionString": "",
      "ContainerName": "documents"
    },
    "AWS": {
      "BucketName": "document-analyzer",
      "Region": "us-east-1",
      "UseInstanceProfile": true
    },
    "AwsS3": {
      "AccessKey": "",
      "SecretKey": "",
      "BucketName": "document-analyzer-docs",
      "Region": "us-east-1"
    }
  },
  "Analysis": {
    "MaxConcurrentAnalyses": 5,
    "TimeoutMinutes": 10,
    "RetryAttempts": 3,
    "OCRProvider": "Tesseract",
    "NLPProvider": "OpenAI",
    "CacheResultsHours": 24
  },
  "DocumentProcessing": {
    "MaxConcurrentProcessing": 5,
    "ProcessingTimeoutMinutes": 30,
    "RetryAttempts": 3,
    "EnableOCR": true,
    "OCRProvider": "Tesseract",
    "TesseractPath": "/usr/bin/tesseract",
    "SupportedLanguages": ["eng", "fra", "deu", "spa"]
  },
  "AnalysisSettings": {
    "EnabledAnalyzers": [
      "TextExtraction",
      "SentimentAnalysis",
      "KeywordExtraction",
      "DocumentClassification"
    ],
    "EnableSentimentAnalysis": true,
    "EnableEntityExtraction": true,
    "EnableKeywordExtraction": true,
    "MaxConcurrentAnalysis": 5,
    "MaxAnalysisTimeMinutes": 15,
    "AnalysisTimeoutMinutes": 10,
    "CacheResultsHours": 24,
    "AIProvider": {
      "Name": "OpenAI",
      "ApiKey": "",
      "Model": "gpt-3.5-turbo",
      "MaxTokens": 2048,
      "Temperature": 0.3
    }
  },
  "ExternalServices": {
    "OpenAI": {
      "ApiKey": "",
      "BaseUrl": "https://api.openai.com/v1",
      "Model": "gpt-3.5-turbo",
      "MaxTokens": 2048,
      "Temperature": 0.7
    },
    "AzureCognitive": {
      "Endpoint": "",
      "ApiKey": "",
      "Region": "eastus"
    }
  },
  "ExternalAPI": {
    "BaseUrl": "https://api.textanalysis.com",
    "ApiKey": "",
    "TimeoutSeconds": 30,
    "MaxRetries": 3
  },
  "SearchSettings": {
    "Provider": "ElasticSearch",
    "ConnectionString": "http://localhost:9200",
    "IndexName": "document-analyzer",
    "MaxSearchResults": 100,
    "MaxResults": 100,
    "SearchTimeoutSeconds": 30,
    "EnableFacetedSearch": true,
    "EnableFaceting": true,
    "EnableAutoComplete": true,
    "ElasticSearch": {
      "Url": "http://localhost:9200",
      "IndexName": "document-analyzer",
      "Username": "",
      "Password": ""
    }
  },
  "Caching": {
    "DefaultExpirationMinutes": 30,
    "DocumentCacheHours": 24,
    "AnalysisCacheHours": 168,
    "MemoryCacheSizeLimitMB": 100
  },
  "CacheSettings": {
    "Provider": "Redis",
    "DefaultExpirationMinutes": 60,
    "SlidingExpirationMinutes": 30,
    "MaxCacheSizeMB": 500,
    "EnableDistributedCache": false,
    "RedisConnection": "localhost:6379",
    "CacheKeyPrefix": "DocumentAnalyzer:",
    "Redis": {
      "ConnectionString": "localhost:6379",
      "InstanceName": "DocumentAnalyzer",
      "Database": 0
    },
    "Memory": {
      "SizeLimit": 104857600
    }
  },
  "Security": {
    "RequireHttps": true,
    "DataProtectionKeyRing": "./keys",
    "AllowedHosts": "*",
    "IPWhitelist": [],
    "EnableAntiForgery": true,
    "ContentSecurityPolicy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
  },
  "SecuritySettings": {
    "EnableApiKeyAuthentication": false,
    "EnableRateLimiting": true,
    "MaxRequestsPerMinute": 100,
    "EnableIPWhitelist": false,
    "IPWhitelist": [],
    "RequireApiKey": false,
    "RequireHttps": false,
    "ApiKeyHeader": "X-API-Key",
    "EnableEncryption": true,
    "EncryptionKey": "your-encryption-key-32-chars-min",
    "HashIterations": 10000,
    "AllowedHosts": "*",
    "IpRateLimiting": {
      "EnableEndpointRateLimiting": true,
      "StackBlockedRequests": false,
      "HttpStatusCode": 429,
      "GeneralRules": [
        {
          "Endpoint": "*",
          "Period": "1m",
          "Limit": 100
        },
        {
          "Endpoint": "*/upload",
          "Period": "1m",
          "Limit": 10
        }
      ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.File", "Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <s:{SourceContext}>{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/documentanalyzer-.log",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 10485760,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId"]
  },
  "NotificationSettings": {
    "EnableEmailNotifications": true,
    "EnableSMSNotifications": false,
    "EnablePushNotifications": false,
    "EmailProvider": "SendGrid",
    "SendGrid": {
      "ApiKey": "",
      "FromEmail": "noreply@documentanalyzer.com",
      "FromName": "Document Analyzer"
    },
    "SMTP": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "EnableSSL": true,
      "Username": "",
      "Password": ""
    },
    "Email": {
      "SmtpServer": "smtp.gmail.com",
      "SmtpPort": 587,
      "Username": "",
      "Password": "",
      "FromAddress": "noreply@documentanalyzer.com",
      "EnableSsl": true
    }
  },
  "HealthChecks": {
    "TimeoutSeconds": 30,
    "CheckIntervalMinutes": 5,
    "EnableUI": true,
    "UIPath": "/health-ui",
    "CheckIntervalSeconds": 30,
    "EnableDetailedErrors": false
  },
  "HealthCheckSettings": {
    "EnableDetailedErrors": true,
    "CheckIntervalSeconds": 30,
    "TimeoutSeconds": 5,
    "FailureThreshold": 3
  },
  "BackgroundJobSettings": {
    "EnableScheduledJobs": true,
    "DocumentCleanupIntervalHours": 24,
    "TempFileCleanupIntervalMinutes": 60,
    "AnalysisQueueProcessingIntervalSeconds": 30
  },
  "Performance": {
    "EnableResponseCompression": true,
    "EnableResponseCaching": true,
    "DefaultCacheProfileDuration": 300,
    "EnableConnectionPooling": true,
    "MaxConnectionPoolSize": 100,
    "ConnectionTimeoutSeconds": 30
  },
  "Monitoring": {
    "EnableMetrics": true,
    "EnableTracing": true,
    "ApplicationInsightsKey": "",
    "CustomMetrics": {
      "DocumentsProcessed": true,
      "AnalysisLatency": true,
      "ErrorRates": true
    }
  },
  "MonitoringSettings": {
    "ApplicationInsights": {
      "InstrumentationKey": "",
      "EnableAdaptiveSampling": true,
      "EnableQuickPulseMetricStream": true
    },
    "EnableMetrics": true,
    "EnableTracing": true,
    "EnablePerformanceCounters": true
  },
  "Features": {
    "EnableBatchProcessing": true,
    "EnableRealTimeAnalysis": true,
    "EnableSearchIndexing": true,
    "EnableAuditLogging": true,
    "MaxBatchSize": 50,
    "EnableDocumentVersioning": true,
    "EnableDocumentSharing": true,
    "EnableCollaboration": false,
    "EnableAdvancedAnalytics": true,
    "EnableBulkOperations": true
  },
  "FeatureFlags": {
    "EnableAdvancedAnalysis": true,
    "EnableBatchProcessing": true,
    "EnableRealTimeNotifications": false,
    "EnableMachineLearning": false,
    "EnableOcrProcessing": true,
    "EnableMultiLanguageSupport": false
  },
  "AllowedHosts": "*"
}
