{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=DocumentAnalyzerDb;Trusted_Connection=true;MultipleActiveResultSets=true",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "SecretKey": "your-super-secret-jwt-key-change-in-production-at-least-32-characters",
    "Issuer": "DocumentAnalyzer",
    "Audience": "DocumentAnalyzer.Client",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Storage": {
    "Type": "Local",
    "BasePath": "./uploads",
    "MaxFileSize": 104857600,
    "AllowedExtensions": [".pdf", ".docx", ".txt", ".jpg", ".png"],
    "Azure": {
      "ConnectionString": "",
      "ContainerName": "documents"
    },
    "AWS": {
      "AccessKey": "",
      "SecretKey": "",
      "BucketName": "document-analyzer",
      "Region": "us-east-1"
    }
  },
  "Analysis": {
    "OcrProvider": "Tesseract",
    "MaxConcurrentAnalysis": 3,
    "TimeoutMinutes": 10,
    "Azure": {
      "CognitiveServicesEndpoint": "",
      "CognitiveServicesKey": ""
    },
    "AWS": {
      "TextractRegion": "us-east-1"
    }
  },
  "Search": {
    "Provider": "ElasticSearch",
    "ElasticSearch": {
      "Uri": "http://localhost:9200",
      "DefaultIndex": "documents",
      "Username": "",
      "Password": ""
    },
    "Azure": {
      "SearchServiceName": "",
      "AdminApiKey": "",
      "QueryApiKey": ""
    }
  },
  "Email": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "noreply@documentanalyzer.com",
    "FromName": "Document Analyzer"
  },
  "AllowedOrigins": [
    "http://localhost:3000",
    "https://localhost:3000"
  ],
  "RateLimiting": {
    "DocumentUpload": {
      "PermitLimit": 10,
      "WindowMinutes": 1
    },
    "Analysis": {
      "PermitLimit": 50,
      "WindowMinutes": 1
    }
  },
  "ExternalServices": {
    "StorageHealthCheck": "https://example.com/health"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <s:{SourceContext}>{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/documentanalyzer-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj} <s:{SourceContext}>{NewLine}{Exception}"
        }
      }
    ]
  },
  "HealthChecks": {
    "UI": {
      "HealthChecksUri": "/health",
      "HealthChecksUIUri": "/health-ui",
      "ApiPath": "/health-ui-api",
      "UIPath": "/health-ui"
    }
  },
  "Cache": {
    "DefaultExpirationMinutes": 30,
    "SlidingExpirationMinutes": 10
  },
  "Security": {
    "RequireHttps": true,
    "HstsMaxAge": 31536000,
    "ContentSecurityPolicy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline';"
  }
}
