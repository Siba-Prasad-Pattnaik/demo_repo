{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information",
      "System": "Warning"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/documentanalyzer-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId"]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=DocumentAnalyzerDb;Trusted_Connection=true;MultipleActiveResultSets=true",
    "Redis": "localhost:6379"
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "https://localhost:5001",
      "Audience": "https://localhost:5001",
      "SecretKey": "YourSuperSecretKeyForJWTTokenGeneration123456789",
      "TokenExpirationMinutes": 60,
      "RefreshTokenExpirationDays": 7,
      "ClockSkew": "00:05:00"
    }
  },
  "Authorization": {
    "Policies": {
      "RequireAdminRole": {
        "RequiredRoles": ["Admin"]
      },
      "RequireUserRole": {
        "RequiredRoles": ["User", "Admin"]
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3001"
    ],
    "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "AllowedHeaders": ["*"],
    "AllowCredentials": true
  },
  "ApiVersioning": {
    "DefaultApiVersion": "1.0",
    "AssumeDefaultVersionWhenUnspecified": true,
    "ApiVersionReader": "Header",
    "ApiVersionHeaderName": "X-Version"
  },
  "Swagger": {
    "Title": "Document Analyzer API",
    "Description": "API for document analysis and processing",
    "ContactName": "API Support",
    "ContactEmail": "support@documentanalyzer.com",
    "Version": "v1"
  },
  "DocumentProcessing": {
    "MaxFileSizeMB": 50,
    "AllowedFileTypes": [".pdf", ".docx", ".txt", ".rtf"],
    "ProcessingTimeoutMinutes": 10,
    "TempStoragePath": "temp/uploads",
    "MaxConcurrentProcessing": 5
  },
  "Storage": {
    "Provider": "Local",
    "Local": {
      "BasePath": "storage/documents",
      "MaxRetentionDays": 365
    },
    "Azure": {
      "ConnectionString": "",
      "ContainerName": "documents",
      "BlobEndpoint": ""
    }
  },
  "Search": {
    "Provider": "ElasticSearch",
    "ElasticSearch": {
      "Uri": "http://localhost:9200",
      "DefaultIndex": "documents",
      "Username": "",
      "Password": ""
    }
  },
  "RateLimiting": {
    "EnableRateLimiting": true,
    "GeneralRules": {
      "PermitLimit": 100,
      "Window": "00:01:00"
    },
    "ApiRules": {
      "Upload": {
        "PermitLimit": 10,
        "Window": "00:01:00"
      },
      "Analysis": {
        "PermitLimit": 20,
        "Window": "00:01:00"
      }
    }
  },
  "HealthChecks": {
    "UI": {
      "HealthCheckUIPath": "/healthchecks-ui",
      "ApiPath": "/health",
      "CheckIntervalSeconds": 30
    }
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "AllowedHosts": "*",
  "Environment": "Development"
}
