FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app
EXPOSE 80
EXPOSE 443

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY ["src/DocumentAnalyzer.API/DocumentAnalyzer.API.csproj", "DocumentAnalyzer.API/"]
COPY ["src/DocumentAnalyzer.Core/DocumentAnalyzer.Core.csproj", "DocumentAnalyzer.Core/"]
COPY ["src/DocumentAnalyzer.Infrastructure/DocumentAnalyzer.Infrastructure.csproj", "DocumentAnalyzer.Infrastructure/"]
RUN dotnet restore "DocumentAnalyzer.API/DocumentAnalyzer.API.csproj"
COPY src/ .
WORKDIR "/src/DocumentAnalyzer.API"
RUN dotnet build "DocumentAnalyzer.API.csproj" -c Release -o /app/build

FROM build AS publish
RUN dotnet publish "DocumentAnalyzer.API.csproj" -c Release -o /app/publish

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "DocumentAnalyzer.API.dll"]
